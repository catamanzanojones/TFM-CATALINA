# --- Datos con copyright y artefactos generados ---
# Se usa "carpeta/*" (y no "carpeta/") para ignorar el CONTENIDO pero poder
# conservar el .gitkeep: git no puede re-incluir un archivo si su carpeta
# entera está excluida.
data/raw/*
!data/raw/.gitkeep
# data/processed contiene el texto del libro convertido (también con copyright)
data/processed/*
!data/processed/.gitkeep
storage/*
!storage/.gitkeep

# --- Secretos ---
.env

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Sistema operativo / editores ---
.DS_Store
Thumbs.db
.vscode/
.idea/
